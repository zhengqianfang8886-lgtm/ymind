// YMind Pro - 润物细无声的 Apple 级仿生连续物理动效引擎
import { bus, EVENTS } from "../core/event-bus.js";
import { drawAppleSquircle } from "../geometry/squircle.js";
import { drawNodeContent } from "./node-drawer.js";
import { isDarkCanvasTheme } from "../data/palettes.js";

class NodeAnimator {
  constructor() {
    this.animatingNodes = new Set();
    this.rafId = null;
    this.lastTime = 0;
    this.initialized = false;
    this.inFrame = false;

    // 🌟 核心突破：跨引用持久状态映射表 (Stable Node ID -> Physics State)
    // 彻底解决撤销/重做 deepCloneTree 导致对象引用断裂而误触发全量爆炸展开
    this.nodeStateMap = new Map();
    this.collapsingEntries = [];
  }

  isAnimating(node) {
    return Boolean(node && this.animatingNodes.has(node));
  }

  // 🌟 手动分支展开：直接将子节点初态绑定在父节点边缘，并彻底清除非法残留的收拢动画条目
  prepareExpand(parentNode) {
    if (!parentNode || !parentNode.children) return;

    // 彻底清除正在收拢列表中的同分支后代，杜绝双向动画重叠拉扯与残影
    const collectSubtreeIds = (n, set = new Set()) => {
      if (!n) return set;
      set.add(n.id);
      if (n.children) n.children.forEach(c => collectSubtreeIds(c, set));
      return set;
    };
    const affectedIds = collectSubtreeIds(parentNode);
    this.collapsingEntries = this.collapsingEntries.filter(e => !affectedIds.has(e.node?.id));

    const pw = parentNode.width || 80;
    const ph = parentNode.height || 36;
    const px = Number.isFinite(parentNode._curX) ? parentNode._curX : (parentNode.x || 0);
    const py = Number.isFinite(parentNode._curY) ? parentNode._curY : (parentNode.y || 0);
    const dir = parentNode.branchDirection || "right";

    const originX = dir === "left" ? px : (dir === "down" ? (px + pw / 2) : (px + pw));
    const originY = dir === "down" ? (py + ph) : (py + ph / 2);

    const stack = [...parentNode.children];
    while (stack.length > 0) {
      const c = stack.pop();
      if (!c) continue;
      this.animatingNodes.delete(c);
      if (c.id) this.nodeStateMap.delete(c.id);

      c._curX = originX - (dir === "left" ? (c.width || 80) : 0);
      c._curY = originY - (c.height || 36) / 2;
      c._vx = 0;
      c._vy = 0;
      c._delay = 0;
      c._curAlpha = 0.0;
      c._isExpanding = true;

      // 仅当子节点本身是展开状态时，其后代才递归初始化，尊重真实折叠语义
      if (c.children && c.children.length > 0 && !c.collapsed) {
        for (let i = 0; i < c.children.length; i++) stack.push(c.children[i]);
      }
    }
  }

  // 🌟 分支收拢动效：捕获正在收起的子分支，平滑吸入父节点折叠按钮中并淡出
  collapseBranch(parentNode) {
    if (!parentNode || !parentNode.children || parentNode.children.length === 0) return;

    // 清除既有收拢条目中冲突的重复项，保证单一真相源
    const collectSubtreeIds = (n, set = new Set()) => {
      if (!n) return set;
      set.add(n.id);
      if (n.children) n.children.forEach(c => collectSubtreeIds(c, set));
      return set;
    };
    const affectedIds = collectSubtreeIds(parentNode);
    affectedIds.delete(parentNode.id);
    this.collapsingEntries = this.collapsingEntries.filter(e => !affectedIds.has(e.node?.id));

    const pw = parentNode.width || 80;
    const ph = parentNode.height || 36;
    const px = Number.isFinite(parentNode._curX) ? parentNode._curX : (parentNode.x || 0);
    const py = Number.isFinite(parentNode._curY) ? parentNode._curY : (parentNode.y || 0);
    const dir = parentNode.branchDirection || "right";

    let anchorX, anchorY;
    if (dir === "left") {
      anchorX = px;
      anchorY = py + ph / 2;
    } else if (dir === "down") {
      anchorX = px + pw / 2;
      anchorY = py + ph;
    } else {
      anchorX = px + pw;
      anchorY = py + ph / 2;
    }

    const now = performance.now();
    const stack = [...parentNode.children];

    while (stack.length > 0) {
      const curr = stack.pop();
      if (!curr) continue;

      const stateRec = curr.id ? this.nodeStateMap.get(curr.id) : null;
      const curX = Number.isFinite(curr._curX) ? curr._curX : (stateRec?.x ?? curr.x ?? anchorX);
      const curY = Number.isFinite(curr._curY) ? curr._curY : (stateRec?.y ?? curr.y ?? anchorY);

      this.animatingNodes.delete(curr);
      if (curr.id) this.nodeStateMap.delete(curr.id);

      this.collapsingEntries.push({
        node: curr,
        startX: curX,
        startY: curY,
        curX: curX,
        curY: curY,
        targetX: anchorX - (dir === "left" ? (curr.width || 80) : 0),
        targetY: anchorY - (curr.height || 36) / 2,
        anchorX: anchorX,
        anchorY: anchorY,
        alpha: 1.0,
        startTime: now,
        duration: 200,
        color: curr.colorTheme ? (curr.colorTheme.line || curr.colorTheme.border) : "#86868b",
        branchDirection: curr.branchDirection || dir
      });

      if (curr.children && curr.children.length > 0 && !curr.collapsed) {
        for (let i = 0; i < curr.children.length; i++) {
          stack.push(curr.children[i]);
        }
      }
    }

    this.startLoop();
  }

  /**
   * 核心坐标追踪调度器
   */
  track(node, targetX, targetY, parentNode = null, childIndex = 0, skipAnimation = false) {
    if (!this.initialized || skipAnimation) {
      node._curX = targetX;
      node._curY = targetY;
      node._curAlpha = 1.0;
      delete node._vx;
      delete node._vy;
      if (node.id) {
        this.nodeStateMap.set(node.id, { x: targetX, y: targetY, alpha: 1.0, vx: 0, vy: 0, time: Date.now() });
      }
      return;
    }

    const stateRecord = node.id ? this.nodeStateMap.get(node.id) : null;

    // 🌟 准则 1：空间连续性继承 (Spatial Continuity)
    // 只要节点在上一帧存在历史物理状态，无条件继承上一次的真实屏幕坐标与速度！
    if (stateRecord && Number.isFinite(stateRecord.x) && Number.isFinite(stateRecord.y)) {
      node._curX = stateRecord.x;
      node._curY = stateRecord.y;
      node._curAlpha = stateRecord.alpha ?? 1.0;
      node._vx = stateRecord.vx ?? 0;
      node._vy = stateRecord.vy ?? 0;
      node._delay = 0;
    } else if (node._curX === undefined || !Number.isFinite(node._curX) || !Number.isFinite(node._curY)) {
      // 🌟 准则 2：真正新入场节点的入场策略
      if (node._isExpanding && parentNode) {
        // A. 用户手动点击加号展开分支：从父节点边缘自然萌芽绽放
        const px = Number.isFinite(parentNode._curX) ? parentNode._curX : (parentNode.x || targetX);
        const py = Number.isFinite(parentNode._curY) ? parentNode._curY : (parentNode.y || targetY);
        const pw = parentNode.width || 80;
        const ph = parentNode.height || 36;
        const dir = node.branchDirection || "right";

        node._curX = dir === "left" ? px : (dir === "down" ? (px + pw / 2) : (px + pw));
        node._curY = dir === "down" ? (py + ph) : (py + ph / 2 - (node.height || 36) / 2);
        node._curAlpha = 0.0;
        node._delay = Math.min(48, (childIndex || 0) * 12);
        delete node._isExpanding;
      } else {
        // B. 撤销复原 / 模板注入 / 动态新增：就地凝聚淡入 (Slot Materialization)
        // 偏移不超过 8px，透明度从 0.35 开始，消除任何突兀的发射与长距离位移！
        const dir = node.branchDirection || "right";
        const offsetSign = dir === "left" ? 8 : (dir === "down" ? 0 : -8);
        node._curX = targetX + offsetSign;
        node._curY = dir === "down" ? (targetY - 6) : targetY;
        node._curAlpha = 0.35;
        node._delay = 0;
      }
    }

    node._targetX = targetX;
    node._targetY = targetY;
    node._vx = Number.isFinite(node._vx) ? node._vx : 0;
    node._vy = Number.isFinite(node._vy) ? node._vy : 0;

    // 动态制动：目标反向时立即消除残留惯性，杜绝过冲震荡
    const toDx = targetX - node._curX;
    const toDy = targetY - node._curY;
    if (node._vx * toDx < 0) node._vx = 0;
    if (node._vy * toDy < 0) node._vy = 0;

    const dist = Math.hypot(toDx, toDy);
    if (dist > 0.4 || (node._curAlpha !== undefined && node._curAlpha < 0.99) || (node._delay && node._delay > 0)) {
      this.animatingNodes.add(node);
      this.startLoop();
    } else {
      node._curX = targetX;
      node._curY = targetY;
      node._curAlpha = 1.0;
      node._vx = 0;
      node._vy = 0;
      this.animatingNodes.delete(node);
      if (node.id) {
        this.nodeStateMap.set(node.id, { x: targetX, y: targetY, alpha: 1.0, vx: 0, vy: 0, time: Date.now() });
      }
    }
  }

  markInitialized() {
    this.initialized = true;
  }

  stopAll() {
    if (this.rafId) {
      if (typeof cancelAnimationFrame === "function") {
        cancelAnimationFrame(this.rafId);
      }
      this.rafId = null;
    }
    if (this.animatingNodes && typeof this.animatingNodes.clear === "function") {
      this.animatingNodes.clear();
    }
  }

  drawCollapsingNodes(ctx, docCtx, scale) {
    if (!this.collapsingEntries || this.collapsingEntries.length === 0) return;

    const isGlobalDark = typeof document !== "undefined" && document.documentElement.getAttribute("data-theme") === "dark";
    const isDarkCanvas = isGlobalDark || isDarkCanvasTheme(docCtx?.canvasBgColor);
    const boxStyle = docCtx?.boxStyle || "squircle";

    for (let i = 0; i < this.collapsingEntries.length; i++) {
      const item = this.collapsingEntries[i];
      const { node, curX, curY, anchorX, anchorY, alpha, color, branchDirection } = item;
      if (alpha <= 0.01) continue;

      const nw = node.width || 80;
      const nh = node.height || 36;
      const childMidY = curY + nh / 2;
      const childMidX = (branchDirection === "left") ? (curX + nw) : curX;

      // 1. 绘制逐渐收紧淡出的贝塞尔连线
      ctx.save();
      ctx.globalAlpha = alpha * 0.75;
      ctx.strokeStyle = color;
      ctx.lineWidth = 2.0 / scale;
      ctx.lineCap = "round";
      ctx.lineJoin = "round";

      ctx.beginPath();
      ctx.moveTo(anchorX, anchorY);
      const dx = childMidX - anchorX;
      const dy = childMidY - anchorY;

      if (branchDirection === "down") {
        ctx.bezierCurveTo(anchorX, anchorY + dy * 0.5, childMidX, childMidY - dy * 0.5, childMidX, childMidY);
      } else {
        ctx.bezierCurveTo(anchorX + dx * 0.5, anchorY, childMidX - dx * 0.5, childMidY, childMidX, childMidY);
      }
      ctx.stroke();
      ctx.restore();

      // 2. 绘制正在吸入的节点卡片 (伴随 100% -> 75% 微缩放与透明度淡出)
      ctx.save();
      ctx.globalAlpha = alpha;

      const shrink = 1.0 - (1.0 - alpha) * 0.25;
      const cx = curX + nw / 2;
      const cy = curY + nh / 2;

      ctx.translate(cx, cy);
      ctx.scale(shrink, shrink);
      ctx.translate(-cx, -cy);

      if (boxStyle !== "underline") {
        const r = 7;
        if (boxStyle === "rect" || scale < 0.35) {
          ctx.beginPath();
          ctx.rect(curX, curY, nw, nh);
        } else {
          drawAppleSquircle(ctx, curX, curY, nw, nh, r);
        }

        if (boxStyle === "solid") {
          ctx.fillStyle = node.colorTheme ? (node.colorTheme.solid || node.colorTheme.border) : "#0071e3";
          ctx.fill();
          ctx.strokeStyle = "rgba(255, 255, 255, 0.40)";
          ctx.lineWidth = 1.8 / scale;
          ctx.stroke();
        } else {
          ctx.fillStyle = isDarkCanvas ? "rgba(30, 36, 48, 0.96)" : "#ffffff";
          ctx.fill();
          ctx.strokeStyle = node.colorTheme ? node.colorTheme.border : (isDarkCanvas ? "rgba(255, 255, 255, 0.25)" : "rgba(0, 0, 0, 0.18)");
          ctx.lineWidth = 1.8 / scale;
          ctx.stroke();
        }
      } else {
        ctx.beginPath();
        ctx.moveTo(curX, curY + nh);
        ctx.lineTo(curX + nw, curY + nh);
        ctx.strokeStyle = color;
        ctx.lineWidth = 2.2 / scale;
        ctx.stroke();
      }

      const savedX = node.x;
      const savedY = node.y;
      node.x = curX;
      node.y = curY;
      drawNodeContent(ctx, node, 2, false, docCtx, scale);
      node.x = savedX;
      node.y = savedY;

      ctx.restore();
    }
  }

  startLoop() {
    if (this.rafId) return;
    this.lastTime = performance.now();

    const step = (now) => {
      this.inFrame = true;
      const dt = Math.min(0.032, (now - this.lastTime) / 1000);
      this.lastTime = now;
      let stillActive = false;

      // 🌟 准则 3：高阶临界阻尼弹簧模型 (Critical Damping: tension=240, friction=31)
      // 阻尼比 zeta = 31 / (2 * sqrt(240)) = 1.0005，彻底消除晃荡，瞬时平滑咬合
      const tension = 240;
      const friction = 31;

      for (const node of this.animatingNodes) {
        if (!Number.isFinite(node._curX) || !Number.isFinite(node._curY) ||
            !Number.isFinite(node._targetX) || !Number.isFinite(node._targetY)) {
          node._curX = Number.isFinite(node._targetX) ? node._targetX : (node.x || 0);
          node._curY = Number.isFinite(node._targetY) ? node._targetY : (node.y || 0);
          node._curAlpha = 1.0;
          node._vx = 0;
          node._vy = 0;
          if (node.id) this.nodeStateMap.set(node.id, { x: node._curX, y: node._curY, alpha: 1.0, vx: 0, vy: 0, time: Date.now() });
          this.animatingNodes.delete(node);
          continue;
        }

        if (node._delay > 0) {
          node._delay -= dt * 1000;
          stillActive = true;
          continue;
        }

        const dx = node._curX - node._targetX;
        const ax = -tension * dx - friction * node._vx;
        node._vx += ax * dt;
        node._curX += node._vx * dt;

        const dy = node._curY - node._targetY;
        const ay = -tension * dy - friction * node._vy;
        node._vy += ay * dt;
        node._curY += node._vy * dt;

        if (node._curAlpha < 1.0) {
          // 150ms 快速柔光渐显
          node._curAlpha = Math.min(1.0, node._curAlpha + dt * 6.5);
        }

        // 同步持久状态映射，供后续任意深拷贝还原即时读取
        if (node.id) {
          this.nodeStateMap.set(node.id, { x: node._curX, y: node._curY, alpha: node._curAlpha, vx: node._vx, vy: node._vy, time: Date.now() });
        }

        const isSettledX = Math.abs(node._curX - node._targetX) < 0.45 && Math.abs(node._vx) < 0.4;
        const isSettledY = Math.abs(node._curY - node._targetY) < 0.45 && Math.abs(node._vy) < 0.4;
        const isSettledAlpha = node._curAlpha >= 0.985;

        if (isSettledX && isSettledY && isSettledAlpha) {
          node._curX = node._targetX;
          node._curY = node._targetY;
          node._curAlpha = 1.0;
          node._vx = 0;
          node._vy = 0;
          this.animatingNodes.delete(node);
          if (node.id) {
            this.nodeStateMap.set(node.id, { x: node._targetX, y: node._targetY, alpha: 1.0, vx: 0, vy: 0, time: Date.now() });
          }
        } else {
          stillActive = true;
        }
      }

      this.inFrame = false;
      bus.emit(EVENTS.RENDER_CANVAS_ONLY);

      // 驱动收拢节点平滑吸入
      if (this.collapsingEntries && this.collapsingEntries.length > 0) {
        const remainingCollapsing = [];
        for (let i = 0; i < this.collapsingEntries.length; i++) {
          const item = this.collapsingEntries[i];
          const elapsed = now - item.startTime;
          const p = Math.min(1.0, elapsed / item.duration);
          const ease = p * p * (3 - 2 * p); // Smoothstep 曲线
          item.curX = item.startX + (item.targetX - item.startX) * ease;
          item.curY = item.startY + (item.targetY - item.startY) * ease;
          item.alpha = Math.max(0, 1.0 - p);

          if (p < 1.0) {
            remainingCollapsing.push(item);
            stillActive = true;
          }
        }
        this.collapsingEntries = remainingCollapsing;
      }

      if (this.animatingNodes.size > 0 || (this.collapsingEntries && this.collapsingEntries.length > 0)) {
        this.rafId = requestAnimationFrame(step);
      } else {
        this.rafId = null;
      }
    };

    this.rafId = requestAnimationFrame(step);
  }
}

export const nodeAnimator = new NodeAnimator();
